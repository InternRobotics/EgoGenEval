{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egogeneval.org/schemas/v0.1/result.schema.json",
  "title": "EgoGenEval evaluator result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_namespace",
    "benchmark_version",
    "evaluator_version",
    "manifest_sha256",
    "code_commit",
    "eligible",
    "evaluated",
    "missing",
    "failed",
    "cmg",
    "ssp",
    "overall"
  ],
  "properties": {
    "result_namespace": {"const": "evaluator-v0.1"},
    "benchmark_version": {"const": "0.1"},
    "evaluator_version": {"const": "0.1"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "code_commit": {"type": "string", "minLength": 1},
    "asset_revision": {"type": "string", "minLength": 1},
    "eval_frames_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reference_fingerprints_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "eligible": {"type": "integer", "minimum": 0},
    "evaluated": {"type": "integer", "minimum": 0},
    "missing": {"type": "integer", "minimum": 0},
    "failed": {"type": "integer", "minimum": 0},
    "cmg": {"type": "number", "minimum": 0, "maximum": 1},
    "cmg_atomic": {"type": "number", "minimum": 0, "maximum": 1},
    "cmg_chain": {"type": "number", "minimum": 0, "maximum": 1},
    "cmg_cycle": {"type": "number", "minimum": 0, "maximum": 1},
    "ssp": {"type": "number", "minimum": 0, "maximum": 1},
    "ssp_atomic": {"type": "number", "minimum": 0, "maximum": 1},
    "ssp_chain": {"type": "number", "minimum": 0, "maximum": 1},
    "ssp_cycle": {"type": "number", "minimum": 0, "maximum": 1},
    "overall": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
